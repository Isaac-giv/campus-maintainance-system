{
  "name": "campus-maintenance-system",
  "version": "0.1.0",
  "private": true,
  "description": "Cosmopolitan University Campus Maintenance Reporting and Tracking System",
  "type": "module",
  "workspaces": [
    "apps/client",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/client",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "clean": "npm run clean --workspaces --if-present",
    "test:db": "node supabase/tests/workflow.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "prettier": "^3.5.3"
  }
}
