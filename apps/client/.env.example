# apps/client environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local — it is git-ignored.

# ── Supabase project credentials ────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
# VITE_SUPABASE_ANON_KEY is the PUBLIC anonymous JWT key.
# It is SAFE to include in the browser bundle — it is subject to RLS.
# It is NOT the service_role key. Never put service_role here.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Express API base URL ─────────────────────────────────────────
# In development, this points to your local Express server.
# In production, this points to your deployed Express API.
VITE_API_BASE_URL=http://localhost:3001/api/v1
