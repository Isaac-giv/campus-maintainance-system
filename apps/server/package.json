    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "prisma": "^6.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
