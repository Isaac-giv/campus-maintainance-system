{
  "name": "@campus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Greenwood University Campus Maintenance System — Express API server",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src --ext .js",
