# ============================================================
# apps/server — Environment Variables Template
# ============================================================
# Copy this file to .env (which is git-ignored) and fill in
# your real values. Never commit .env to version control.
# ============================================================

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Supabase Project Configuration ───────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# The service-role key is used ONLY by Express Admin SDK calls
# (token verification, storage admin, GoTrue admin).
# It is NOT a PostgreSQL database password.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Prisma Database Connections ───────────────────────────────
#
# DATABASE_URL: Supavisor Session Pooler — used by Prisma at runtime.
#   Username format for custom roles: campus_app.<project-ref>
#   Port: 5432 (session pooler on pooler host)
#   Host: aws-0-<region>.pooler.supabase.com
#
DATABASE_URL=postgresql://campus_app.<project-ref>:<campus-app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DIRECT_URL: Direct connection — used by Prisma CLI for migrations only.
#   Username format: postgres.<project-ref>
#   Port: 5432 on pooler host (IPv4-safe via Supavisor session mode).
#   This connection requires a role with DDL privileges (postgres or campus_admin).
#
DIRECT_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed client origins.
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
# Maximum requests per IP per 15-minute window on auth endpoints.
RATE_LIMIT_AUTH_MAX=20

# ── Signed URL TTL ────────────────────────────────────────────
# Lifetime of storage signed URLs in seconds. Default: 900 (15 min).
SIGNED_URL_TTL_SECONDS=900
